# Copy to .env and fill in real values for production / shared local stack.
# Secrets must be >= 32 characters for HMAC-256.
# Must match the corresponding secrets in ms-auth.

# Session JWTs (frontend Bearer) — same as ms-auth APP_JWT_SECRET_SESSION
APP_JWT_SECRET_SESSION=replace-with-strong-random-secret-min-32-chars

# Master JWTs (ms-auth Feign) — same as ms-auth APP_JWT_SECRET_MASTER
APP_JWT_SECRET_MASTER=replace-with-strong-random-secret-min-32-chars

# Fallback alias (legacy) — used only if APP_JWT_SECRET_SESSION is unset
# APP_JWT_SECRET=replace-with-strong-random-secret-min-32-chars

# CORS (comma-separated origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: enable Swagger outside the dev profile
# SWAGGER_ENABLED=true

# Production Postgres (do not set these for local H2/dev profile)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/practica
# SPRING_DATASOURCE_USERNAME=practica
# SPRING_DATASOURCE_PASSWORD=changeme
